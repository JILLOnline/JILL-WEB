      <path d="M4 7h16M4 12h16M4 17h16"/>
    </svg>
  {% when 'search' %}
    <svg viewBox="0 0 24 24" width="1em" height="1em" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true" focusable="false">
      <circle cx="11" cy="11" r="6.5"/><path d="m16 16 4 4"/>
