{% liquid
  assign item_title = product.title | default: ''
  assign item_title = item_title
    | replace: 'Custom Handmade ', ''
    | replace: 'Custom Kids ', 'Kids '
    | replace: 'Custom ', ''
    | replace: 'Personalized ', ''
    | replace: ' – Made to Order', ''
    | replace: ' – Personalized Party Favors', ''
    | replace: ' – Personalized Print', ''
    | replace: ' – Custom Photo, Text & Design', ''
    | replace: 'Party Favor ', ''
    | replace: ' – Includes Stick', ' + Stick'
    | replace: ' Inch', ' in'
    | replace: ' Count', ' ct'
    | replace: ' Pieces', ' pc'
    | replace: 'Kids Activity Kit with Play-Doh', 'Activity Kit + Play-Doh'
    | replace: 'Crewneck Sweatshirt', 'Crewneck'
%}
{{ item_title | strip }}
