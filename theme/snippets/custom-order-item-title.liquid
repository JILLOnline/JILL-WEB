{% liquid
  assign item_title = product.title | default: ''
  assign item_title = item_title | replace: 'Custom Handmade ', ''
  assign item_title = item_title | replace: 'Custom Kids ', 'Kids '
  assign item_title = item_title | replace: 'Custom ', ''
  assign item_title = item_title | replace: 'Personalized ', ''
  assign item_title = item_title | replace: 'DTF ', ''
  assign item_title = item_title | replace: 'Sublimation ', ''
  assign item_title = item_title | replace: 'Vinyl ', ''
  assign item_title = item_title | replace: 'Party Favor ', ''
  assign item_title = item_title | replace: 'Party Favor', ''

  assign title_segments = item_title | split: ' – '
  assign unit_title = title_segments.first | strip

  for segment in title_segments offset: 1
    assign clean_segment = segment | strip
    assign is_pack_quantity = false
    if clean_segment contains ' Count' or clean_segment contains ' Pieces'
      assign is_pack_quantity = true
    endif

    assign is_listing_method = false
    if clean_segment == 'Made to Order' or clean_segment == 'Personalized Party Favors' or clean_segment == 'Personalized Print' or clean_segment == 'Custom Photo, Text & Design'
      assign is_listing_method = true
    endif

    unless is_pack_quantity or is_listing_method
      assign unit_title = unit_title | append: ' – ' | append: clean_segment
    endunless
  endfor

  assign unit_title = unit_title | replace: 'Kids Activity Kit with Play-Doh', 'Activity Kit with Play-Doh'
  assign unit_title = unit_title | replace: 'Crewneck Fleece - Everyday Wear', 'Crewneck'
  assign unit_title = unit_title | replace: 'Crewneck Fleece', 'Crewneck'
  assign unit_title = unit_title | replace: 'Coffee Mug', 'Mug'
%}
{{ unit_title | strip }}
