{% comment %}
  Canonical Custom Order capability projection.

  Custom Order owns order-level personalization and reference uploads separately from
  Product Page capability fields. This projection deliberately exposes only the
  Product Options contract to the shared product runtime so hidden Product Page
  personalization fields can never block or corrupt a Custom Order request.

  One Custom Order quantity always represents one requested/customizable unit.
{% endcomment %}
{
  "version": {{ capability_profile.version | default: 1 | json }},
  "id": {{ capability_profile.id | default: 'custom_order_profile' | json }},
  "fields": [
    {% assign emitted_field_count = 0 %}
    {% for field in capability_profile.fields %}
      {% if field.group == 'product_options' %}
        {% if emitted_field_count > 0 %},{% endif %}
        {{ field | json }}
        {% assign emitted_field_count = emitted_field_count | plus: 1 %}
      {% endif %}
    {% endfor %}
  ],
  "features": {
    "customizationUnits": {
      "unitsPerQuantity": 1,
      "singularLabel": {{ capability_profile.features.customizationUnits.singularLabel | default: 'item' | json }},
      "pluralLabel": {{ capability_profile.features.customizationUnits.pluralLabel | default: 'items' | json }}
    }{% if capability_profile.features.productOptionsAllocation != blank %},
    "productOptionsAllocation": {{ capability_profile.features.productOptionsAllocation | json }}{% endif %}{% if capability_profile.features.commerceAdjustments != blank %},
    "commerceAdjustments": {{ capability_profile.features.commerceAdjustments | json }}{% endif %}
  }
}