{% liquid
  assign choice_type = type | default: 'checkbox'
  assign choice_id = id | default: name
%}

<label class="jill-choice" for="{{ choice_id }}"{% if error != blank %} data-state="error"{% endif %}>
  <input
    class="jill-choice__control"
    id="{{ choice_id }}"
    name="{{ name }}"
    type="{{ choice_type }}"
    value="{{ value | default: '1' | escape }}"
    {% if checked %}checked{% endif %}
    {% if required %}required{% endif %}
    {% if disabled %}disabled{% endif %}
    {% if error != blank %}aria-invalid="true" aria-describedby="{{ choice_id }}-error"{% endif %}
  >
  <span class="jill-choice__label">{{ label }}</span>
  {% if required %}<span class="jill-field__required" aria-hidden="true">*</span>{% endif %}
</label>

{% if error != blank %}
  <p class="jill-field__message" id="{{ choice_id }}-error" data-tone="error">{{ error }}</p>
{% endif %}
