<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <link rel="canonical" href="{{ canonical_url }}">

    {% render 'meta-tags' %}

    {{ content_for_header }}

    {{ 'jill-foundation.css' | asset_url | stylesheet_tag: preload: true }}
    {{ 'jill-ui.css' | asset_url | stylesheet_tag }}
    {{ 'jill-storefront.css' | asset_url | stylesheet_tag }}
  </head>

  <body>
    <a class="jill-skip-link" href="#MainContent">{{ 'accessibility.skip_to_content' | t }}</a>

    {% sections 'header-group' %}

    <main id="MainContent" class="jill-main" role="main" tabindex="-1">
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}

    {% if request.page_type == 'product' %}
      <script src="{{ 'jill-product-capabilities.js' | asset_url }}" defer></script>
      <script src="{{ 'jill-form-engine.js' | asset_url }}" defer></script>
      <script src="{{ 'jill-product-options.js' | asset_url }}" defer></script>
      <script src="{{ 'jill-product.js' | asset_url }}" defer></script>
    {% endif %}
  </body>
</html>
