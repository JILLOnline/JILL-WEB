<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <link rel="canonical" href="{{ canonical_url }}">

    {% render 'meta-tags' %}

    {{ content_for_header }}

    {{ 'jill-foundation.css' | asset_url | stylesheet_tag: preload: true }}
    {{ 'jill-ui.css' | asset_url | stylesheet_tag }}
    {{ 'jill-storefront.css' | asset_url | stylesheet_tag }}
    {{ 'jill-category-dock.css' | asset_url | stylesheet_tag }}

    {% liquid
      assign is_custom_order_template = false
      if template.suffix == 'custom-order' or template.suffix == 'our-story'
        assign is_custom_order_template = true
      endif

      assign is_contact_template = false
      if template.suffix == 'contact'
        assign is_contact_template = true
      endif
    %}

    {% if is_custom_order_template or is_contact_template %}
      {{ 'jill-forms.css' | asset_url | stylesheet_tag }}
    {% endif %}
  </head>

  <body>
    <a class="jill-skip-link" href="#MainContent">{{ 'accessibility.skip_to_content' | t }}</a>

    {% sections 'header-group' %}

    <main id="MainContent" class="jill-main" role="main" tabindex="-1">
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}

    <script src="{{ 'jill-header.js' | asset_url }}" defer></script>
    <script src="{{ 'jill-quantity.js' | asset_url }}" defer></script>
    {% if request.page_type == 'product' or is_custom_order_template %}
      <script src="{{ 'jill-product-capabilities.js' | asset_url }}" defer></script>
      <script src="{{ 'jill-form-engine.js' | asset_url }}" defer></script>
      <script src="{{ 'jill-product-options.js' | asset_url }}" defer></script>
      <script src="{{ 'jill-personalization.js' | asset_url }}" defer></script>
      <script src="{{ 'jill-personalization-ui.js' | asset_url }}" defer></script>
      {% if request.page_type == 'product' %}
        <script src="{{ 'jill-product-surface.js' | asset_url }}" defer></script>
      {% endif %}
      <script src="{{ 'jill-product.js' | asset_url }}" defer></script>
    {% endif %}
    {% if request.page_type == 'product' %}
      <script src="{{ 'jill-commerce-adjustments.js' | asset_url }}" defer></script>
      <script src="{{ 'jill-commerce-cart.js' | asset_url }}" defer></script>
      <script src="{{ 'jill-product-commerce.js' | asset_url }}" defer></script>
    {% endif %}
    {% if is_custom_order_template %}
      <script src="{{ 'jill-variant-allocation.js' | asset_url }}" defer></script>
      <script src="{{ 'jill-custom-order.js' | asset_url }}" defer></script>
    {% endif %}
    {% if is_contact_template %}
      <script src="{{ 'jill-contact.js' | asset_url }}" defer></script>
    {% endif %}
    {% if request.page_type == 'collection' and collection.handle == 'all' %}
      <script src="{{ 'jill-catalog.js' | asset_url }}" defer></script>
    {% endif %}
  </body>
</html>
