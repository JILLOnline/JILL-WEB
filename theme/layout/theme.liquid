<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <link rel="canonical" href="{{ canonical_url }}">

    {% render 'meta-tags' %}

    {{ content_for_header }}

    {{ 'jill-foundation.css.liquid' | asset_url | stylesheet_tag: preload: true }}
    {{ 'jill-ui.css' | asset_url | stylesheet_tag }}
    {{ 'jill-storefront.css' | asset_url | stylesheet_tag }}
  </head>

  <body>
    <a class="jill-skip-link" href="#MainContent">Skip to content</a>

    {% sections 'header-group' %}

    <main id="MainContent" class="jill-main" role="main" tabindex="-1">
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}
  </body>
</html>
