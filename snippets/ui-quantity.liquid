{% liquid
  assign quantity_id = id | default: name
  assign quantity_value = value | default: 1
%}

<div class="jill-quantity"{% if error != blank %} data-state="error"{% endif %}>
  <label class="jill-field__label" for="{{ quantity_id }}">
    {{ label | default: 'Quantity' }}
    {% if required %}<span class="jill-field__required" aria-hidden="true">*</span>{% endif %}
  </label>

  <input
    class="jill-field__control jill-quantity__control"
    id="{{ quantity_id }}"
    name="{{ name }}"
    type="number"
    inputmode="numeric"
    value="{{ quantity_value }}"
    min="{{ min | default: 1 }}"
    {% if max != blank %}max="{{ max }}"{% endif %}
    step="{{ step | default: 1 }}"
    {% if required %}required{% endif %}
    {% if disabled %}disabled{% endif %}
    {% if error != blank %}aria-invalid="true" aria-describedby="{{ quantity_id }}-error"{% endif %}
  >

  {% if error != blank %}
    <p class="jill-field__message" id="{{ quantity_id }}-error" data-tone="error">{{ error }}</p>
  {% endif %}
</div>
