{% liquid
  assign card_url = card_product.url
  assign card_title = card_product.title
  assign card_display_title = card_product.metafields.custom.card_title.value | default: blank
  assign current_price = card_product.price
  assign compare_price = card_product.compare_at_price
  assign price_varies = card_product.price_varies
  assign card_mode = mode | default: 'default'
  assign view_product_label = 'catalog.card.view_product' | t
  assign customize_label = 'catalog.card.customize' | t
  assign is_catalog = false
  assign card_heading_tag = heading_tag | default: 'h2'

  if card_display_title == blank
    case card_product.handle
      when 'custom-coffee-mug-photo-sublimation-74734'
        assign card_display_title = '11 oz Mug'
      when 'cake-toppers-1x-large-12x-small-91117'
        assign card_display_title = 'Cake Topper Set'
      when 'party-favors-coloring-books-custom-08343'
        assign card_display_title = 'Coloring Books'
      when 'custom-dtf-crewneck-fleece-for-your-crew-48791'
        assign card_display_title = 'Crewneck'
      when 'custom-dtf-hoodie-for-your-crew-21083'
        assign card_display_title = 'Hoodie'
      when 'custom-dtf-t-shirts-for-your-crew-67138'
        assign card_display_title = 'T-Shirt'
      when 'pinata-custom-theme-13-inches-round-96685'
        assign card_display_title = '13" Round'
      when 'pinata-custom-theme-all-ages-18-71638'
        assign card_display_title = '18" Number'
      when 'pinata-with-stick-custom-theme-all-87524'
        assign card_display_title = '18" Number With Stick'
      when 'pinata-custom-theme-includes-stick-76338'
        assign card_display_title = '36" Number With Stick'
      when 'party-favors-coloring-box-activity-60610'
        assign card_display_title = 'Activity Kit'
      when 'party-favors-snack-bags-custom-theme-99329'
        assign card_display_title = 'Snack Bags'
      when 'party-favors-surprise-bags-custom-35779'
        assign card_display_title = 'Surprise Bags'
      when 'party-favors-surprise-box-custom-05087'
        assign card_display_title = 'Surprise Boxes'
      when 'tote-bag-vinyl-transfer-custom'
        assign card_display_title = 'Tote Bag'
      else
        assign card_display_title = card_title
    endcase
  endif

  if card_mode == 'catalog'
    assign is_catalog = true
    if heading_tag == blank
      assign card_heading_tag = 'h3'
    endif
  endif

  assign custom_order_link = blank
  if is_catalog and custom_order_url != blank
    assign encoded_handle = card_product.handle | url_encode
    assign separator = '?'
    if custom_order_url contains '?'
      assign separator = '&'
    endif
    assign custom_order_link = custom_order_url | append: separator | append: 'product=' | append: encoded_handle
  endif
%}

<article
  class="jill-product-card{% if is_catalog %} jill-card{% endif %}"
  {% if is_catalog %}data-display="catalog"{% endif %}
>
  <a
    class="jill-product-card__media"
    href="{{ card_url }}"
    aria-label="{{ card_title | escape }}"
    data-jill-product-card-media
  >
    {% if card_product.featured_image != blank %}
      {{ card_product.featured_image | image_url: width: 900 | image_tag: class: 'jill-product-card__image', loading: 'lazy', widths: '320, 480, 640, 900', sizes: '(min-width: 70rem) 30vw, (min-width: 45rem) 45vw, 100vw' }}
    {% else %}
      <span class="jill-product-card__image-placeholder" aria-hidden="true"></span>
    {% endif %}
  </a>

  <div class="jill-product-card__details">
    {% if show_vendor and card_product.vendor != blank %}
      <p class="jill-product-card__vendor">{{ card_product.vendor }}</p>
    {% endif %}

    <div class="jill-product-card__price">
      {% if price_varies %}<span>{{ 'products.card.from' | t }}</span>{% endif %}
      <span>{{ current_price | money }}</span>
      {% if compare_price != blank and compare_price > current_price %}
        <s>{{ compare_price | money }}</s>
      {% endif %}
    </div>

    <{{ card_heading_tag }} class="jill-product-card__title">
      <a href="{{ card_url }}" aria-label="{{ card_title | escape }}">{{ card_display_title }}</a>
    </{{ card_heading_tag }}>

    {% unless card_product.available %}
      <span class="jill-pill" data-tone="muted">{{ 'products.product.sold_out' | t }}</span>
    {% endunless %}

    {% if is_catalog %}
      <div class="jill-product-card__actions">
        {% render 'ui-button', type: 'button', label: view_product_label, url: card_url %}
        {% if custom_order_link != blank %}
          {% render 'ui-button', type: 'button', label: customize_label, url: custom_order_link, variant: 'secondary' %}
        {% endif %}
      </div>
    {% endif %}
  </div>
</article>