<footer class="jill-site-footer">
  <div class="jill-site-footer__inner jill-page-width">
    <div>
      <strong>JILL</strong>
      {% if section.settings.tagline != blank %}
        <p>{{ section.settings.tagline }}</p>
      {% endif %}
      <p class="jill-site-footer__thanks">Every order means the world to us. Thank you for supporting a small business built on love, color and joy. <span>With love, the JILL Team.</span></p>
      <small>&copy; {{ 'now' | date: '%Y' }} JILL. Handmade with heart.</small>
    </div>

    <nav aria-label="{{ 'footer.navigation' | t }}">
      {% if section.settings.menu != blank %}
        {% for link in section.settings.menu.links %}
          <a href="{{ link.url }}">{{ link.title }}</a>
        {% endfor %}
      {% endif %}

      {% if settings.social_instagram_url != blank %}
        <a href="{{ settings.social_instagram_url }}" target="_blank" rel="noopener noreferrer">{{ 'footer.instagram' | t }}</a>
      {% endif %}
      {% if settings.social_facebook_url != blank %}
        <a href="{{ settings.social_facebook_url }}" target="_blank" rel="noopener noreferrer">{{ 'footer.facebook' | t }}</a>
      {% endif %}
      {% if settings.social_tiktok_url != blank %}
        <a href="{{ settings.social_tiktok_url }}" target="_blank" rel="noopener noreferrer">{{ 'footer.tiktok' | t }}</a>
      {% endif %}
      {% if settings.social_youtube_url != blank %}
        <a href="{{ settings.social_youtube_url }}" target="_blank" rel="noopener noreferrer">YouTube</a>
      {% endif %}
    </nav>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    {
      "type": "text",
      "id": "tagline",
      "label": "Tagline",
      "default": "Thoughtful details for celebrations worth remembering."
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu",
      "default": "footer"
    }
  ]
}
{% endschema %}
