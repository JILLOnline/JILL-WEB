{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jill.local/contracts/product-capability-profile.schema.json",
  "title": "JILL Product Capability Profile",
  "description": "Canonical normalized product capability contract consumed by JILL Theme Core feature engines. Product families are configuration, never separate engines.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "id", "fields", "features"],
  "properties": {
    "version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$",
      "minLength": 1,
      "maxLength": 64
    },
    "fields": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/field"
      }
    },
    "features": {
      "$ref": "#/$defs/features"
    }
  },
  "$defs": {
    "condition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field", "operator", "value"],
      "properties": {
        "field": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "operator": {
          "enum": ["equals", "not_equals", "in", "not_in"]
        },
        "value": {
          "oneOf": [
            {"type": "string"},
            {"type": "number"},
            {"type": "boolean"},
            {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "oneOf": [
                  {"type": "string"},
                  {"type": "number"},
                  {"type": "boolean"}
                ]
              }
            }
          ]
        }
      }
    },
    "visibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "conditions"],
      "properties": {
        "mode": {
          "enum": ["all", "any"]
        },
        "conditions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/condition"
          }
        }
      }
    },
    "option": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "label"],
      "properties": {
        "value": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      }
    },
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "group", "label", "required"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$",
          "minLength": 1,
          "maxLength": 64
        },
        "kind": {
          "enum": ["text", "textarea", "number", "select", "radio", "checkbox", "date", "file"]
        },
        "group": {
          "enum": ["product_options", "personalization", "planning", "reference"]
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "help": {
          "type": "string",
          "maxLength": 500
        },
        "required": {
          "type": "boolean"
        },
        "minLength": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "maxLength": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "min": {
          "type": "number"
        },
        "max": {
          "type": "number"
        },
        "step": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "options": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/option"
          }
        },
        "accept": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          }
        },
        "maxFiles": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        },
        "visibleWhen": {
          "$ref": "#/$defs/visibility"
        }
      }
    },
    "customizationUnits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unitsPerQuantity"],
      "properties": {
        "unitsPerQuantity": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "singularLabel": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "pluralLabel": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        }
      }
    },
    "personalizationAllocation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "allowedModes", "fieldIds"],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "allowedModes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": ["same", "different"]
          }
        },
        "fieldIds": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          }
        }
      }
    },
    "datePlanning": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "fieldId", "minimumLeadBusinessDays"],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "fieldId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "minimumLeadBusinessDays": {
          "type": "integer",
          "minimum": 0,
          "maximum": 365
        },
        "fulfillmentFieldId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "appliesToFulfillmentValues": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "referenceUpload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "fieldId"],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "fieldId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        }
      }
    },
    "features": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "customizationUnits": {
          "$ref": "#/$defs/customizationUnits"
        },
        "personalizationAllocation": {
          "$ref": "#/$defs/personalizationAllocation"
        },
        "datePlanning": {
          "$ref": "#/$defs/datePlanning"
        },
        "referenceUpload": {
          "$ref": "#/$defs/referenceUpload"
        }
      }
    }
  }
}
